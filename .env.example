# Quick Note — configuration template.
# Every value below comes from the environment. The service validates them at startup and
# refuses to start when a required value is missing or invalid. Never commit real secrets.

# --- Database (unset in dev/test: Quarkus Dev Services supplies them) ---
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/quicknote
QUARKUS_DATASOURCE_USERNAME=quicknote
QUARKUS_DATASOURCE_PASSWORD=change-me

# --- Identity (verified here, issued by Keycloak) ---
QUARKUS_OIDC_AUTH_SERVER_URL=http://localhost:8180/realms/quicknote
QUARKUS_OIDC_CLIENT_ID=quicknote-api

# --- Behaviour ---
QUICKNOTE_TRASH_RETENTION_DAYS=30
QUICKNOTE_RATELIMIT_PER_PRINCIPAL=600
QUICKNOTE_RATELIMIT_PER_IP=1200
