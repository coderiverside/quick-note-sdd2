#!/usr/bin/env bash
# Rejects a commit message that is not a Conventional Commit.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
if command -v npx >/dev/null 2>&1; then
  npx --no-install commitlint --edit "$1" && exit 0
fi
# Fallback so the rule still holds without a Node toolchain present.
header=$(head -1 "$1")
if [[ "$header" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?:\ .{1,90}$ ]]; then
  exit 0
fi
echo "commit-msg: not a Conventional Commit." >&2
echo "  expected: <type>(<optional scope>): <subject>" >&2
echo "  got:      $header" >&2
exit 1
